---
const siteUrl = (Astro.site?.toString() ?? "https://srouter.web.id").replace(/\/$/, "");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const pageTitle = "SRouter | One local endpoint for your model stack";
const pageDescription =
    "SRouter is a local-first AI gateway for coding tools and applications. Route OpenAI and Anthropic-compatible requests, manage providers and keys, and inspect traffic from one local control surface.";
const socialImageUrl = `${siteUrl}/images/og-image.png`;
const faqItems = [
    {
        question: "What is SRouter?",
        answer:
            "SRouter is a local-first AI gateway. It gives coding tools and applications one endpoint for OpenAI-compatible and Anthropic-compatible requests while it handles provider connections, routing, keys, quotas, and logs."
    },
    {
        question: "Where does SRouter keep my local data?",
        answer:
            "The Docker setup stores the SQLite database and provider credentials in the mounted ~/.srouter directory. You control the machine, the volume, and the gateway endpoint."
    },
    {
        question: "Which tools and clients can connect?",
        answer:
            "Use OpenAI-compatible or Anthropic-compatible SDKs and cURL. The SRouter CLI can also configure Claude Code and OpenCode to use the gateway."
    },
    {
        question: "Can I connect a custom provider?",
        answer:
            "Yes. SRouter supports custom endpoints with custom headers, alongside its built-in provider connections and model prefixes."
    }
];
const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebSite",
            "@id": `${siteUrl}/#website`,
            name: "SRouter",
            url: siteUrl,
            description: pageDescription,
            inLanguage: "en"
        },
        {
            "@type": "WebPage",
            "@id": `${canonicalUrl}#webpage`,
            name: pageTitle,
            url: canonicalUrl,
            description: pageDescription,
            isPartOf: { "@id": `${siteUrl}/#website` },
            inLanguage: "en"
        },
        {
            "@type": "SoftwareApplication",
            name: "SRouter",
            applicationCategory: "DeveloperApplication",
            operatingSystem: "Docker, Linux, macOS, Windows",
            description: pageDescription,
            url: siteUrl
        },
        {
            "@type": "FAQPage",
            mainEntity: faqItems.map(({ question, answer }) => ({
                "@type": "Question",
                name: question,
                acceptedAnswer: {
                    "@type": "Answer",
                    text: answer
                }
            }))
        }
    ]
};
---

<!doctype html>
<html lang="en" data-theme="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#0d1110" />
        <meta name="application-name" content="SRouter" />
        <meta name="description" content={pageDescription} />
        <meta name="robots" content="index, follow" />
        <link rel="canonical" href={canonicalUrl} />
        <link rel="sitemap" type="application/xml" href={`${siteUrl}/sitemap-index.xml`} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="manifest" href="/manifest.webmanifest" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
        />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:site_name" content="SRouter" />
        <meta property="og:image" content={socialImageUrl} />
        <meta property="og:image:alt" content="SRouter local AI gateway landing page" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="675" />
        <meta property="og:locale" content="en_US" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={pageDescription} />
        <meta name="twitter:image" content={socialImageUrl} />
        <meta name="twitter:image:alt" content="SRouter local AI gateway landing page" />
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
        <title>{pageTitle}</title>
        <script is:inline>
            (() => {
                const storedTheme = window.localStorage.getItem("srouter-theme");
                const theme = storedTheme === "light" || storedTheme === "dark" ? storedTheme : "dark";
                document.documentElement.dataset.theme = theme;
                document.documentElement.style.colorScheme = theme;
            })();
        </script>
    </head>
    <body>
        <a class="skip-link" href="#main-content">Skip to content</a>
        <slot />
        <script>
            const root = document.documentElement;
            const themeToggle = document.querySelector("[data-theme-toggle]");
            const themeLabel = document.querySelector("[data-theme-label]");
            const mobileToggle = document.querySelector("[data-mobile-toggle]");
            const mobileNav = document.querySelector("[data-mobile-nav]");

            const setTheme = (theme: "dark" | "light") => {
                root.dataset.theme = theme;
                root.style.colorScheme = theme;
                window.localStorage.setItem("srouter-theme", theme);
                if (themeLabel) {
                    themeLabel.textContent = theme === "dark" ? "Use light theme" : "Use dark theme";
                }
            };

            if (themeLabel) {
                themeLabel.textContent = root.dataset.theme === "dark" ? "Use light theme" : "Use dark theme";
            }

            themeToggle?.addEventListener("click", () => {
                setTheme(root.dataset.theme === "dark" ? "light" : "dark");
            });

            mobileToggle?.addEventListener("click", () => {
                const isOpen = mobileNav?.getAttribute("data-open") === "true";
                mobileNav?.setAttribute("data-open", String(!isOpen));
                mobileToggle.setAttribute("aria-expanded", String(!isOpen));
            });

            document.querySelectorAll("[data-nav-link]").forEach((link) => {
                link.addEventListener("click", () => {
                    mobileNav?.setAttribute("data-open", "false");
                    mobileToggle?.setAttribute("aria-expanded", "false");
                });
            });

            document.querySelectorAll("[data-copy-target]").forEach((button) => {
                button.addEventListener("click", async () => {
                    const targetId = button.getAttribute("data-copy-target");
                    const target = targetId ? document.getElementById(targetId) : null;
                    const value = target?.textContent?.trim();
                    if (!value) return;

                    try {
                        await navigator.clipboard.writeText(value);
                        const originalLabel = button.textContent;
                        button.textContent = "Copied";
                        window.setTimeout(() => {
                            button.textContent = originalLabel;
                        }, 1400);
                    } catch {
                        const originalLabel = button.textContent;
                        button.textContent = "Select command";
                        window.setTimeout(() => {
                            button.textContent = originalLabel;
                        }, 1400);
                    }
                });
            });
        </script>
    </body>
</html>

<style is:global>
    :root {
        --bg: #0d1110;
        --surface: #121917;
        --surface-raised: #18211d;
        --surface-soft: #202c26;
        --ink: #eef3e8;
        --ink-soft: #b8c7bc;
        --faint: #819087;
        --line: #2b3a31;
        --line-strong: #4a5d4e;
        --accent: #c7f36a;
        --accent-ink: #0d1110;
        --accent-soft: #34421f;
        --danger: #ff9c89;
        --code-bg: #080c0a;
        --code-ink: #eef3e8;
        --max-width: 1240px;
        --sans: "IBM Plex Sans", system-ui, sans-serif;
        --mono: "JetBrains Mono", ui-monospace, monospace;
    }

    [data-theme="light"] {
        --bg: #f4f3ee;
        --surface: #fbfaf6;
        --surface-raised: #ffffff;
        --surface-soft: #e9ece5;
        --ink: #17201d;
        --ink-soft: #53615b;
        --faint: #78847c;
        --line: #d6ddd4;
        --line-strong: #aab8ad;
        --accent: #a8d944;
        --accent-ink: #17201d;
        --accent-soft: #e1f3b9;
        --danger: #9b3d30;
        --code-bg: #17201d;
        --code-ink: #eef3e8;
    }

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
        background: var(--bg);
    }

    body {
        min-width: 320px;
        margin: 0;
        color: var(--ink);
        background: var(--bg);
        font-family: var(--sans);
        font-size: 16px;
        line-height: 1.55;
        text-rendering: optimizeLegibility;
    }

    body::selection {
        color: var(--accent-ink);
        background: var(--accent);
    }

    a {
        color: inherit;
        text-underline-offset: 0.2em;
    }

    button,
    input {
        font: inherit;
    }

    button,
    a {
        -webkit-tap-highlight-color: transparent;
    }

    button:focus-visible,
    a:focus-visible,
    input:focus-visible,
    summary:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 3px;
    }

    .skip-link {
        position: fixed;
        z-index: 100;
        top: 12px;
        left: 12px;
        padding: 10px 14px;
        color: var(--accent-ink);
        background: var(--accent);
        transform: translateY(-180%);
        transition: transform 160ms ease;
    }

    .skip-link:focus {
        transform: translateY(0);
    }

    .site-header {
        position: sticky;
        z-index: 20;
        top: 0;
        border-bottom: 1px solid color-mix(in srgb, var(--line) 90%, transparent);
        background: color-mix(in srgb, var(--bg) 92%, transparent);
        backdrop-filter: blur(14px);
    }

    .header-inner {
        display: flex;
        width: min(100% - 48px, var(--max-width));
        min-height: 72px;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin: 0 auto;
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 11px;
        color: var(--ink);
        font-family: var(--mono);
        font-size: 0.88rem;
        font-weight: 700;
        letter-spacing: -0.04em;
        text-decoration: none;
    }

    .brand-mark {
        display: grid;
        width: 32px;
        height: 32px;
        place-items: center;
        color: var(--accent-ink);
        background: var(--accent);
        font-size: 0.72rem;
        font-weight: 700;
    }

    .brand-context {
        color: var(--faint);
        font-weight: 400;
    }

    .desktop-nav {
        display: flex;
        align-items: center;
        gap: 3px;
        margin-left: auto;
    }

    .desktop-nav a,
    .mobile-nav a {
        min-height: 44px;
        padding: 10px 12px;
        color: var(--ink-soft);
        font-family: var(--mono);
        font-size: 0.7rem;
        text-decoration: none;
        transition: color 160ms ease, background 160ms ease;
    }

    .desktop-nav a:hover,
    .mobile-nav a:hover {
        color: var(--ink);
        background: var(--surface-soft);
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .source-link,
    .icon-button,
    .menu-button {
        display: inline-grid;
        min-width: 44px;
        min-height: 44px;
        place-items: center;
        color: var(--ink-soft);
        border: 1px solid var(--line);
        background: transparent;
        cursor: pointer;
        text-decoration: none;
        transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
    }

    .source-link {
        padding: 10px 13px;
        font-family: var(--mono);
        font-size: 0.68rem;
    }

    .source-link:hover,
    .icon-button:hover,
    .menu-button:hover {
        color: var(--ink);
        border-color: var(--line-strong);
        background: var(--surface-soft);
    }

    .icon-button svg,
    .menu-button svg {
        width: 18px;
        height: 18px;
        fill: none;
        stroke: currentColor;
        stroke-linecap: square;
        stroke-linejoin: miter;
        stroke-width: 1.6;
    }

    .menu-button {
        display: none;
    }

    .mobile-nav {
        display: none;
        width: min(100% - 48px, var(--max-width));
        margin: 0 auto;
        padding: 0 0 16px;
    }

    .mobile-nav[data-open="true"] {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 4px;
    }

    .main-content,
    .site-footer-inner {
        width: min(100% - 48px, var(--max-width));
        margin: 0 auto;
    }

    .main-content {
        padding: 66px 0 110px;
    }

    .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(340px, 0.95fr);
        gap: clamp(40px, 7vw, 100px);
        align-items: center;
        min-height: 590px;
        padding: 32px 0 88px;
        border-bottom: 1px solid var(--line);
    }

    .eyebrow,
    .section-kicker,
    .mini-label {
        color: var(--faint);
        font-family: var(--mono);
        font-size: 0.66rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        line-height: 1.4;
        text-transform: uppercase;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 26px;
    }

    .eyebrow::before {
        display: block;
        width: 30px;
        height: 3px;
        content: "";
        background: var(--accent);
    }

    h1,
    h2,
    h3,
    p {
        margin-top: 0;
    }

    h1,
    h2,
    h3 {
        color: var(--ink);
        font-weight: 600;
        letter-spacing: -0.05em;
    }

    h1 {
        max-width: 720px;
        margin-bottom: 24px;
        font-size: clamp(3.6rem, 8vw, 7.4rem);
        line-height: 0.91;
    }

    h2 {
        margin-bottom: 14px;
        font-size: clamp(2rem, 4.2vw, 4rem);
        line-height: 0.98;
    }

    h3 {
        margin-bottom: 8px;
        font-size: 1.08rem;
        line-height: 1.15;
    }

    .hero-lede {
        max-width: 590px;
        margin-bottom: 30px;
        color: var(--ink-soft);
        font-size: clamp(1.03rem, 1.5vw, 1.2rem);
        line-height: 1.5;
    }

    .hero-actions,
    .inline-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
    }

    .button {
        display: inline-flex;
        min-height: 46px;
        align-items: center;
        justify-content: center;
        padding: 10px 16px;
        border: 1px solid var(--ink);
        font-family: var(--mono);
        font-size: 0.7rem;
        font-weight: 700;
        text-decoration: none;
        transition: transform 160ms ease, background 160ms ease, color 160ms ease;
    }

    .button:hover {
        transform: translateY(-2px);
    }

    .button-primary {
        color: var(--accent-ink);
        background: var(--accent);
    }

    .button-primary:hover {
        color: var(--surface);
        background: var(--ink);
    }

    .button-secondary {
        color: var(--ink);
        background: transparent;
    }

    .button-secondary:hover {
        background: var(--surface-soft);
    }

    .hero-microcopy {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin-top: 24px;
        color: var(--faint);
        font-family: var(--mono);
        font-size: 0.63rem;
    }

    .hero-microcopy span::before {
        display: inline-block;
        width: 6px;
        height: 6px;
        margin-right: 7px;
        content: "";
        background: var(--accent);
    }

    .route-visual {
        position: relative;
        padding: 22px;
        border: 1px solid var(--line-strong);
        background: var(--surface);
    }

    .route-visual::before,
    .route-visual::after {
        position: absolute;
        content: "";
        background: var(--accent);
    }

    .route-visual::before {
        top: 22px;
        right: 22px;
        width: 8px;
        height: 8px;
    }

    .route-visual::after {
        right: 30px;
        bottom: 22px;
        width: 1px;
        height: 78px;
        opacity: 0.6;
    }

    .route-topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 34px;
        color: var(--faint);
        font-family: var(--mono);
        font-size: 0.62rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .route-status {
        color: var(--accent);
    }

    .route-flow {
        display: grid;
        gap: 0;
    }

    .route-node {
        display: grid;
        grid-template-columns: 12px minmax(0, 1fr);
        gap: 13px;
        align-items: start;
        min-height: 76px;
    }

    .route-node-marker {
        position: relative;
        display: block;
        width: 12px;
        height: 12px;
        margin-top: 4px;
        border: 1px solid var(--accent);
        background: var(--surface);
    }

    .route-node-marker::after {
        position: absolute;
        top: 11px;
        left: 5px;
        width: 1px;
        height: 64px;
        content: "";
        background: var(--line-strong);
    }

    .route-node:last-child .route-node-marker::after {
        display: none;
    }

    .route-node strong {
        display: block;
        color: var(--ink);
        font-family: var(--mono);
        font-size: 0.75rem;
    }

    .route-node small {
        display: block;
        margin-top: 5px;
        color: var(--ink-soft);
        font-size: 0.78rem;
    }

    .route-node.active .route-node-marker {
        background: var(--accent);
        box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 13%, transparent);
    }

    .route-node.active strong {
        color: var(--accent);
    }

    .provider-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 12px;
    }

    .provider-pills span {
        padding: 5px 7px;
        color: var(--ink-soft);
        border: 1px solid var(--line);
        font-family: var(--mono);
        font-size: 0.58rem;
    }

    .signal-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        margin: 34px 0 0;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
    }

    .signal-strip span {
        padding: 16px 14px;
        color: var(--faint);
        border-right: 1px solid var(--line);
        font-family: var(--mono);
        font-size: 0.61rem;
        letter-spacing: 0.05em;
        text-align: center;
        text-transform: uppercase;
    }

    .signal-strip span:last-child {
        border-right: 0;
    }

    .section {
        padding: 112px 0;
        border-bottom: 1px solid var(--line);
        scroll-margin-top: 88px;
    }

    .section-head {
        display: grid;
        grid-template-columns: 180px minmax(0, 720px);
        gap: 32px;
        align-items: start;
        margin-bottom: 52px;
    }

    .section-kicker {
        padding-top: 8px;
    }

    .section-head p {
        max-width: 660px;
        margin-bottom: 0;
        color: var(--ink-soft);
        font-size: 1.05rem;
    }

    .dashboard-stage {
        display: grid;
        grid-template-columns: minmax(0, 1.42fr) minmax(250px, 0.58fr);
        gap: 20px;
        align-items: stretch;
    }

    .dashboard-frame {
        overflow: hidden;
        border: 1px solid var(--line-strong);
        background: var(--surface);
    }

    .dashboard-frame picture,
    .dashboard-frame img {
        display: block;
        width: 100%;
        height: auto;
    }

    .dashboard-frame figcaption {
        padding: 10px 14px;
        color: var(--faint);
        border-top: 1px solid var(--line);
        font-family: var(--mono);
        font-size: 0.6rem;
    }

    .surface-list {
        display: grid;
        align-content: center;
        border-top: 1px solid var(--line);
    }

    .surface-item {
        padding: 22px 0;
        border-bottom: 1px solid var(--line);
    }

    .surface-item:first-child {
        border-top: 3px solid var(--accent);
    }

    .surface-item b {
        display: block;
        margin-bottom: 7px;
        color: var(--accent);
        font-family: var(--mono);
        font-size: 0.64rem;
    }

    .surface-item strong {
        display: block;
        margin-bottom: 6px;
        color: var(--ink);
        font-size: 1rem;
    }

    .surface-item p {
        margin: 0;
        color: var(--ink-soft);
        font-size: 0.82rem;
        line-height: 1.5;
    }

    .capability-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 18px;
    }

    .capability {
        min-height: 220px;
        padding: 24px;
        border: 1px solid var(--line);
        background: var(--surface);
    }

    .capability.featured {
        grid-row: span 2;
        min-height: 458px;
        background: var(--surface-raised);
    }

    .capability-number {
        display: inline-block;
        margin-bottom: 72px;
        padding: 5px 8px;
        color: var(--accent-ink);
        background: var(--accent);
        font-family: var(--mono);
        font-size: 0.62rem;
        font-weight: 700;
    }

    .capability h3 {
        max-width: 400px;
        font-size: clamp(1.35rem, 2.5vw, 2.1rem);
    }

    .capability p {
        max-width: 410px;
        margin-bottom: 0;
        color: var(--ink-soft);
        font-size: 0.9rem;
    }

    .capability:not(.featured) .capability-number {
        margin-bottom: 38px;
        color: var(--accent);
        background: transparent;
        border: 1px solid var(--line-strong);
    }

    .provider-stage {
        display: grid;
        grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
        gap: 48px;
        align-items: start;
    }

    .provider-stage > p {
        margin: 0;
        color: var(--ink-soft);
        font-size: 1.02rem;
    }

    .provider-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        border-top: 1px solid var(--line);
        border-left: 1px solid var(--line);
    }

    .provider-row {
        display: grid;
        gap: 7px;
        min-height: 100px;
        padding: 15px;
        border-right: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
    }

    .provider-row strong {
        color: var(--ink);
        font-size: 0.88rem;
    }

    .provider-row span {
        color: var(--faint);
        font-family: var(--mono);
        font-size: 0.62rem;
    }

    .run-stage {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
        gap: 44px;
        align-items: start;
    }

