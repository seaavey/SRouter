{
    "name": "srouter",
    "version": "0.1.3",
    "description": "High-performance multi-provider AI Gateway and LLM proxy router built with Hono, TypeScript, and SQLite WAL",
    "author": "Muhammad Adriansyah",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/seaavey/SRouter.git"
    },
    "keywords": [
        "ai-gateway",
        "llm-proxy",
        "openai-compatible",
        "anthropic-compatible",
        "hono",
        "sqlite",
        "antigravity",
        "gemini",
        "claude",
        "chatgpt",
        "router"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/seaavey/SRouter.git"
    },
    "homepage": "https://github.com/seaavey/SRouter#readme",
    "bugs": {
        "url": "https://github.com/seaavey/SRouter/issues"
    },
    "license": "MIT",
    "scripts": {
        "dev": "turbo dev",
        "start": "turbo start",
        "build": "turbo build",
        "clean": "turbo clean || rm -rf apps/*/dist packages/*/dist .turbo",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "turbo lint",
        "test": "turbo test",
        "srouter": "pnpm --filter @srouter/cli exec tsx src/index.ts"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af",
    "dependencies": {
        "@xyflow/system": "^0.0.80",
        "turbo": "^2.10.9"
    },
    "devDependencies": {
        "prettier": "^3.5.0",
        "typescript": "^5.0.0"
    }
}
