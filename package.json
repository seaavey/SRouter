{
    "name": "srouter",
    "version": "0.1.1",
    "description": "High-performance multi-provider AI Gateway and LLM proxy router built with Hono, TypeScript, and SQLite WAL",
    "author": "Muhammad Adriansyah",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/seaavey/SRouter.git"
    },
    "keywords": [
        "ai-gateway",
        "llm-proxy",
        "openai-compatible",
        "anthropic-compatible",
        "hono",
        "sqlite",
        "antigravity",
        "gemini",
        "claude",
        "chatgpt",
        "router"
    ],
    "scripts": {
        "dev": "turbo dev",
        "start": "turbo start",
        "build": "turbo build",
        "clean": "turbo clean || rm -rf apps/*/dist packages/*/dist .turbo",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "turbo lint",
        "test": "turbo test"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "pnpm@11.20.0",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.20.0",
            "onFail": "download"
        }
    },
    "dependencies": {
        "turbo": "^2.10.9"
    },
    "devDependencies": {
        "prettier": "^3.5.0",
        "typescript": "^5.0.0"
    }
}
