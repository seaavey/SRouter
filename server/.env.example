# =============================================================================
# SRouter Rust server (server/) — environment configuration
# Copy to `.env` or export these variables before running the binary.
# Only the variables the Rust server actually reads are listed here.
# =============================================================================

# Main HTTP listener (default: 3000)
PORT=3000

# SQLite database location
# - Default: ~/.srouter/srouter.db (HOME is required when this is unset)
# - Docker: /app/data/srouter.db
DATABASE_PATH=~/.srouter/srouter.db

# PostgreSQL storage is NOT SUPPORTED. SQLite is the only backend (owner ruling
# 2026-10-08). The Rust server refuses to start when this is set: PostgreSQL has
# no schema carrier or repository statements, so a boot would come up with no
# tables and answer every request from empty defaults. Leave it unset and use
# DATABASE_PATH.
# DATABASE_URL=postgres://user:pass@host:5432/srouter

# Built dashboard static files (optional). This repository no longer contains a
# dashboard, so set this only if you mount one yourself. Without it, GET / answers
# with the API information object.
# WEB_DIST_PATH=/srv/srouter-web/dist

# Public callback base URL. When set it is treated as the canonical public origin.
# An `https://` URL automatically turns secure cookies on (see SROUTER_SECURE_COOKIES).
# SROUTER_PUBLIC_URL=https://srouter.example.com

# Comma-separated public CORS allowlist (loopback origins are always allowed)
# SROUTER_CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Optional admin bootstrap/reset password: creates the account when missing and
# resets the password on every boot while set.
# SROUTER_ADMIN_PASSWORD=

# Set to "true" to add the Secure flag to the admin session cookie (HTTPS deployments).
# Not needed when SROUTER_PUBLIC_URL already starts with https:// — that implies it;
# under https:// this flag cannot turn Secure off.
# SROUTER_SECURE_COOKIES=false

# Runtime environment (default: production). Production is assumed when this is
# unset or holds any other value; `development` is the only opt-out and turns the
# per-request access log on.
# NODE_ENV=development

# Per-request access log (method, path, redacted query/headers/body, status, duration).
# Default: off unless NODE_ENV=development. Set to "on" to force it, "off" to silence it.
# SROUTER_ACCESS_LOG=on

# File logging under logs/srouter-server.log.
# Default: false (stdout only). Set to "true" to write to logs/srouter-server.log.
# SROUTER_FILE_LOG=false

# Log level (default: info). Written to stdout (and logs/srouter-server.log if enabled).
RUST_LOG=info

# ---------------------------------------------------------------------------
# Optional search-provider keys (fallback to zero-config scraping when unset)
# ---------------------------------------------------------------------------
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=
# SEARXNG_URL=